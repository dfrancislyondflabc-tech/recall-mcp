{
  "_comment": "Secrets policy for the memory corpus. Enforced at INDEX time and again at,OUTPUT time (get / neighbors / search) — belt and braces, because an index,built by an older version of this server must not be able to leak.,NOTE: no plaintext credential appears in this file. Known literal secrets are,listed as sha256 hashes of their lowercased form (tokenHashesSha256) so the,denylist itself is safe to commit.,,Every pattern carries a `class` from the CLOSED vocabulary in lib/secrets.js,(credential-shaped / token-shaped / key-shaped; the hash route emits,known-credential). The marker is [REDACTED:<class>] so a reader knows WHY a,hole is in the text — and the class must never encode anything about the,redacted content itself: no lengths, no fragments, no charset hints.,The negative lookaheads match \\[REDACTED[\\]:] so neither the old bare,marker (still present in previously-scrubbed corpus text) nor the new,class-tagged one can re-fire a pattern. excludeFiles and sectionScrub ship EMPTY: they are per-machine. excludeFiles takes memory FILENAMES that must never be indexed; sectionScrub maps a filename to headings to strip. This file is public, so name files by path, not by what they contain.",
  "excludeFiles": [],
  "sectionScrub": {},
  "patterns": [
    {
      "name": "sshpass-single-quoted",
      "class": "credential-shaped",
      "re": "sshpass\\s+-p\\s*'(?!\\[REDACTED[\\]:])[^']*'",
      "flags": "gi",
      "replace": "sshpass -p '[REDACTED:credential-shaped]'"
    },
    {
      "name": "sshpass-double-quoted",
      "class": "credential-shaped",
      "re": "sshpass\\s+-p\\s*\"(?!\\[REDACTED[\\]:])[^\"]*\"",
      "flags": "gi",
      "replace": "sshpass -p \"[REDACTED:credential-shaped]\""
    },
    {
      "name": "sshpass-bare",
      "class": "credential-shaped",
      "re": "sshpass\\s+-p\\s+(?!\\[REDACTED[\\]:])[^\\s`'\"]+",
      "flags": "gi",
      "replace": "sshpass -p [REDACTED:credential-shaped]"
    },
    {
      "_note": "A bare -p is NOT a password flag: unzip -p, mkdir -p and docker -p all use it. Scope the quoted--p rule to commands that actually take a password there, or the guard shreds the corpus.",
      "name": "cred-flag-p-quoted",
      "class": "credential-shaped",
      "re": "(sshpass|smbclient|mysql|mysqldump|psql|redis-cli|mosquitto_pub|mosquitto_sub|docker\\s+login|rsync)([^\\n'\"]{0,60}?)-p\\s*'(?!\\[REDACTED[\\]:])[^']{3,}'",
      "flags": "gi",
      "replace": "$1$2-p '[REDACTED:credential-shaped]'"
    },
    {
      "name": "cred-flag-p-double-quoted",
      "class": "credential-shaped",
      "re": "(sshpass|smbclient|mysql|mysqldump|psql|redis-cli|mosquitto_pub|mosquitto_sub|docker\\s+login|rsync)([^\\n'\"]{0,60}?)-p\\s*\"(?!\\[REDACTED[\\]:])[^\"]{3,}\"",
      "flags": "gi",
      "replace": "$1$2-p \"[REDACTED:credential-shaped]\""
    },
    {
      "name": "password-colon",
      "class": "credential-shaped",
      "re": "password\\s*[:=]\\s*(?!\\[REDACTED[\\]:])(?!(?:the|a|an|this|that|these|those|your|our|their|its|it|is|are|was|were|will|shall|must|should|can|may)\\b)[`'\"]?[^\\s`'\",;]{3,}[`'\"]?",
      "flags": "gi",
      "replace": "password: [REDACTED:credential-shaped]"
    },
    {
      "name": "passwd-colon",
      "class": "credential-shaped",
      "re": "passwd\\s*[:=]\\s*(?!\\[REDACTED[\\]:])(?!(?:the|a|an|this|that|these|those|your|our|their|its|it|is|are|was|were|will|shall|must|should|can|may)\\b)[`'\"]?[^\\s`'\",;]{3,}[`'\"]?",
      "flags": "gi",
      "replace": "passwd: [REDACTED:credential-shaped]"
    },
    {
      "name": "user-slash-pass-backticked",
      "class": "credential-shaped",
      "re": "`admin`\\s*/\\s*`(?!\\[REDACTED[\\]:])[^`]{3,}`",
      "flags": "gi",
      "replace": "`admin` / `[REDACTED:credential-shaped]`"
    },
    {
      "name": "bearer-token",
      "class": "token-shaped",
      "re": "\\bBearer\\s+(?!\\[REDACTED[\\]:])[A-Za-z0-9._~+/=-]{16,}",
      "flags": "g",
      "replace": "Bearer [REDACTED:token-shaped]"
    },
    {
      "name": "token-assignment",
      "class": "token-shaped",
      "re": "\\b([A-Z0-9_]*(?:TOKEN|SECRET|APIKEY|API_KEY|ACCESS_KEY|AUTH_TOKEN|CLIENT_SECRET))\\s*[:=]\\s*['\"`]?(?!\\[REDACTED[\\]:])[A-Za-z0-9._~+/-]{16,}",
      "flags": "g",
      "replace": "$1=[REDACTED:token-shaped]"
    },
    {
      "name": "api-key-prefixed",
      "class": "key-shaped",
      "re": "\\b(?:sk|pk|ghp|gho|ghs|xoxb|xoxp|AKIA|ASIA)[-_][A-Za-z0-9]{12,}",
      "flags": "g",
      "replace": "[REDACTED:key-shaped]"
    },
    {
      "name": "api-key-prefixed-hyphenated",
      "class": "key-shaped",
      "re": "\\b(?:sk|pk|ghp|gho|ghs|xoxb|xoxp|AKIA|ASIA)[-_](?!\\[REDACTED[\\]:])[A-Za-z0-9][A-Za-z0-9_-]{10,}",
      "flags": "g",
      "replace": "[REDACTED:key-shaped]"
    },
    {
      "name": "jwt",
      "class": "token-shaped",
      "re": "\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}",
      "flags": "g",
      "replace": "[REDACTED:token-shaped]"
    },
    {
      "name": "token-query-param",
      "class": "token-shaped",
      "re": "\\b[A-Za-z_][A-Za-z0-9_]*(?:token|key|secret|passwd|password)\\s*=\\s*(?!\\[REDACTED[\\]:])[A-Za-z0-9._~+/-]{16,}",
      "flags": "gi",
      "replace": "[REDACTED:token-shaped]"
    },
    {
      "name": "webhook-signing-secret",
      "class": "key-shaped",
      "re": "\\bwhsec_(?!\\[REDACTED[\\]:])[A-Za-z0-9_-]{16,}",
      "flags": "g",
      "replace": "[REDACTED:key-shaped]"
    },
    {
      "name": "user-slash-pass-unbackticked",
      "class": "credential-shaped",
      "re": "\\badmin\\s*/\\s*(?!\\[REDACTED[\\]:])(?=[^\\s]{0,40}\\d)(?=[^\\s]{0,40}[A-Z*!@#$%^&+])[^\\s`'\"/]{8,}",
      "flags": "g",
      "replace": "admin/[REDACTED:credential-shaped]"
    }
  ],
  "tokenHashesSha256": [
    "ed4fc7db458a35b9e2c034a36567239286d5096880a9db4946fb733e6f447ab1",
    "f0e0ac74af53fe907d37baa46ba04d9f1d88af23b53a99847c755bbb033e73a1",
    "66e56772063a2b5870202dc3275d86d353050a4640d904d5bcf3bcc928c4a20d",
    "a788c65ee452b761e1625b61b4572afbbcf5f1d6cd1518f3acdef768220908ad"
  ]
}
